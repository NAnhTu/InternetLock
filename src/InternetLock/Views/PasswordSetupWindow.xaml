<Window x:Class="InternetLock.Views.PasswordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết lập mật khẩu lần đầu" Height="380" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F172A" Foreground="#F8FAFC"
        UseLayoutRounding="True">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Internet Lock" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
            <TextBlock Text="Chào mừng! Vui lòng tạo mật khẩu bảo vệ ứng dụng (tối thiểu 6 ký tự)."
                       FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Error Message -->
        <Border Grid.Row="1" x:Name="ErrorBorder" Background="#3B0764" BorderBrush="#A855F7" BorderThickness="1" 
                CornerRadius="6" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="ErrorTextBlock" Foreground="#E9D5FF" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Input Fields -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <TextBlock Text="Mật khẩu mới:" Foreground="#CBD5E1" FontSize="13" Margin="0,0,0,6"/>
            <PasswordBox x:Name="NewPasswordBox" Height="38" Background="#1E293B" Foreground="#FFFFFF"
                         BorderBrush="#334155" BorderThickness="1" Padding="8,6" FontSize="14"/>

            <TextBlock Text="Xác nhận mật khẩu:" Foreground="#CBD5E1" FontSize="13" Margin="0,14,0,6"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="38" Background="#1E293B" Foreground="#FFFFFF"
                         BorderBrush="#334155" BorderThickness="1" Padding="8,6" FontSize="14"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" Width="90" Height="36" Click="CancelButton_Click"
                    Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Tạo mật khẩu" Width="120" Height="36" Click="SaveButton_Click"
                    Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
