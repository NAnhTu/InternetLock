<Window x:Class="InternetLock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:InternetLock.Converters"
        xmlns:models="clr-namespace:InternetLock.Models"
        Title="Internet Lock" Height="560" Width="720"
        MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        UseLayoutRounding="True">

    <Window.Resources>
        <converters:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- Custom Large ToggleSwitch Style -->
        <Style x:Key="LargeToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SwitchTrack" CornerRadius="25" Background="#334155" Padding="4">
                            <Grid>
                                <Ellipse x:Name="SwitchThumb" Width="42" Height="42" HorizontalAlignment="Left" Fill="#94A3B8">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#10B981"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="ThumbTransform" Property="X" Value="50"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & App Title -->
            <RowDefinition Height="Auto"/> <!-- Status Card & Big Toggle -->
            <RowDefinition Height="Auto"/> <!-- Operation Result Summary -->
            <RowDefinition Height="*"/>    <!-- Network Adapters List -->
            <RowDefinition Height="Auto"/> <!-- Footer / Control Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. App Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="12" Height="12" CornerRadius="6" Background="#38BDF8" Margin="0,0,10,0"/>
                <TextBlock Text="Internet Lock" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
            </StackPanel>
            <Button Content="Đổi mật khẩu" HorizontalAlignment="Right" Command="{Binding ChangePasswordCommand}"
                    Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" 
                    Padding="12,6" FontSize="12" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- 2. Main Status Card with Large Toggle -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" 
                CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="10" Height="10" Fill="{Binding CurrentStatus, Converter={StaticResource StatusToBrushConverter}}" 
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="{Binding CurrentStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusDescription}" FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Big Toggle Switch -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <ToggleButton Style="{StaticResource LargeToggleSwitchStyle}" 
                                  IsChecked="{Binding IsToggleChecked, Mode=OneWay}"
                                  Command="{Binding ToggleLockCommand}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                    <TextBlock Text="{Binding IsToggleChecked, Converter={StaticResource BooleanToStatusConverter}}" 
                               HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Operation Notification / Summary Banner -->
        <Border Grid.Row="2" Background="#0284C7" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                Visibility="{Binding LastOperationSummary, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding LastOperationSummary}" Foreground="#FFFFFF" FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <!-- 4. Adapter List Section -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Danh sách card mạng trên hệ thống" FontSize="14" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                <Button Content="Làm mới" Command="{Binding RefreshCommand}" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#38BDF8" BorderThickness="0" Cursor="Hand" FontSize="12">
                </Button>
            </Grid>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Adapters}" AutoGenerateColumns="False" 
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                      RowBackground="#1E293B" AlternatingRowBackground="#0F172A"
                      Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                      HeadersVisibility="Column" ColumnHeaderHeight="36">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên Card Mạng" Binding="{Binding Name}" Width="140"/>
                    <DataGridTextColumn Header="Loại" Binding="{Binding AdapterType}" Width="100"/>
                    <DataGridTextColumn Header="Mô Tả Interface" Binding="{Binding InterfaceDescription}" Width="*"/>
                    <DataGridTemplateColumn Header="Trạng Thái" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Left"
                                        Background="{Binding IsEnabled, Converter={StaticResource StatusToBrushConverter}}">
                                    <TextBlock Text="{Binding IsEnabled, Converter={StaticResource BooleanToStatusConverter}}" 
                                               Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 5. Footer Buttons -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Tắt toàn bộ" Command="{Binding DisableAllCommand}" Width="110" Height="36" Margin="0,0,10,0"
                        Background="#EF4444" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Bật lại card mạng" Command="{Binding EnableSavedCommand}" Width="130" Height="36"
                        Background="#10B981" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <Button Content="Đóng ứng dụng" Command="{Binding CloseAppCommand}" HorizontalAlignment="Right" Width="120" Height="36"
                    Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- 6. Busy Progress Overlay -->
        <Border Grid.RowSpan="5" Background="#CC0F172A" Visibility="{Binding IsBusy, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <TextBlock Text="{Binding BusyMessage}" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" 
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <ProgressBar IsIndeterminate="True" Height="8" Background="#334155" Foreground="#38BDF8" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
