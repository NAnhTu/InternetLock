<Window x:Class="InternetLock.Views.PasswordConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận mở Internet" Height="360" Width="430"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F172A" Foreground="#F8FAFC"
        UseLayoutRounding="True">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Mở kết nối Internet" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
            <TextBlock Text="Nhập mật khẩu của bạn để bật lại các card mạng."
                       FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Error / Countdown Banner -->
        <Border Grid.Row="1" x:Name="ErrorBorder" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" 
                CornerRadius="6" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="ErrorTextBlock" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Password Field with Show/Hide toggle -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <TextBlock Text="Mật khẩu:" Foreground="#CBD5E1" FontSize="13" Margin="0,0,0,6"/>
            
            <Grid Height="38">
                <PasswordBox x:Name="ConfirmPasswordBox" Height="38" Background="#1E293B" Foreground="#FFFFFF"
                             BorderBrush="#334155" BorderThickness="1" Padding="8,6" FontSize="14"/>
                <TextBox x:Name="ConfirmTextBox" Height="38" Background="#1E293B" Foreground="#FFFFFF"
                         BorderBrush="#334155" BorderThickness="1" Padding="8,6" FontSize="14" Visibility="Collapsed"/>
            </Grid>

            <CheckBox x:Name="ShowPasswordCheckBox" Content="Hiển thị mật khẩu" Foreground="#94A3B8" 
                      Margin="0,10,0,0" FontSize="12" Checked="ShowPasswordCheckBox_CheckedChanged" Unchecked="ShowPasswordCheckBox_CheckedChanged"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="Hủy" Width="90" Height="36" Click="CancelButton_Click"
                    Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="ConfirmBtn" Content="Xác nhận" Width="110" Height="36" Click="ConfirmButton_Click"
                    Background="#10B981" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
