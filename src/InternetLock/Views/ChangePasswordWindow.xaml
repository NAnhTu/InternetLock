<Window x:Class="InternetLock.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu" Height="420" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F172A" Foreground="#F8FAFC"
        UseLayoutRounding="True">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Đổi mật khẩu" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
            <TextBlock Text="Cập nhật mật khẩu bảo vệ cho ứng dụng Internet Lock."
                       FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Error Message -->
        <Border Grid.Row="1" x:Name="ErrorBorder" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" 
                CornerRadius="6" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="ErrorTextBlock" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Form Fields -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <TextBlock Text="Mật khẩu hiện tại:" Foreground="#CBD5E1" FontSize="13" Margin="0,0,0,4"/>
            <PasswordBox x:Name="CurrentPasswordBox" Height="36" Background="#1E293B" Foreground="#FFFFFF"
                         BorderBrush="#334155" BorderThickness="1" Padding="8,5" FontSize="14"/>

            <TextBlock Text="Mật khẩu mới (tối thiểu 6 ký tự):" Foreground="#CBD5E1" FontSize="13" Margin="0,10,0,4"/>
            <PasswordBox x:Name="NewPasswordBox" Height="36" Background="#1E293B" Foreground="#FFFFFF"
                         BorderBrush="#334155" BorderThickness="1" Padding="8,5" FontSize="14"/>

            <TextBlock Text="Xác nhận mật khẩu mới:" Foreground="#CBD5E1" FontSize="13" Margin="0,10,0,4"/>
            <PasswordBox x:Name="ConfirmNewPasswordBox" Height="36" Background="#1E293B" Foreground="#FFFFFF"
                         BorderBrush="#334155" BorderThickness="1" Padding="8,5" FontSize="14"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" Width="90" Height="36" Click="CancelButton_Click"
                    Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Lưu mật khẩu" Width="120" Height="36" Click="SaveButton_Click"
                    Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
